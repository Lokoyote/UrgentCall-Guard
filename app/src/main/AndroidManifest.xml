<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions requises pour la détection des appels et l'envoi de SMS -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UrgentCallGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.UrgentCallGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.UrgentCallGuard" />

        <activity
            android:name=".WhitelistActivity"
            android:exported="false"
            android:label="@string/whitelist_title"
            android:theme="@style/Theme.UrgentCallGuard" />

        <activity
            android:name=".AddFromContactsActivity"
            android:exported="false"
            android:label="@string/contacts_picker_title"
            android:theme="@style/Theme.UrgentCallGuard" />

        <activity
            android:name=".BlacklistActivity"
            android:exported="false"
            android:label="@string/blacklist_title"
            android:theme="@style/Theme.UrgentCallGuard" />

        <!-- Notification Permanente Foreground Service -->
        <service
            android:name=".UrgentCallForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Urgent Call and Silent Mode Monitoring" />
        </service>

        <!-- BroadcastReceiver pour écouter les états d'appel -->
        <receiver
            android:name=".CallBroadcastReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Redémarre le service au boot si activé par l'utilisateur -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Relance le service si sa notification est glissée (Android 14+) ou tué par le système -->
        <receiver
            android:name=".ServiceRestartReceiver"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>
