<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions requises pour la détection des appels et l'envoi de SMS -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UrgentCallGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.UrgentCallGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.UrgentCallGuard" />

        <activity
            android:name=".ListsActivity"
            android:exported="false"
            android:label="@string/lists_title"
            android:theme="@style/Theme.UrgentCallGuard" />

        <activity
            android:name=".AddFromContactsActivity"
            android:exported="false"
            android:label="@string/contacts_picker_title"
            android:theme="@style/Theme.UrgentCallGuard" />

        <!-- Service ponctuel : actif uniquement pendant une fenêtre de rappel
             d'urgence après un appel manqué. Jamais démarré au boot,
             jamais relancé automatiquement (voir UrgentCallForegroundService). -->
        <service
            android:name=".UrgentCallForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Urgent Call and Silent Mode Monitoring" />
        </service>

        <!-- BroadcastReceiver pour écouter les états d'appel : c'est le seul
             point d'entrée de l'app en arrière-plan. PHONE_STATE est un
             broadcast protégé par permission système (READ_PHONE_STATE),
             donc Android continue de le délivrer à ce receiver déclaré dans
             le manifeste même si le process de l'app a été tué entre-temps :
             aucun service permanent n'est nécessaire pour détecter un appel. -->
        <receiver
            android:name=".CallBroadcastReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
