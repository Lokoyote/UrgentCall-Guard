<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_50">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/settings_volume_threshold_label"
            android:textColor="@color/slate_900"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/volumeThresholdSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/volumeThresholdValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:textColor="@color/slate_500"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/settings_timer_label"
            android:textColor="@color/slate_900"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/timerMinutesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:inputType="number"
            android:maxLength="3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/settings_sms_template_label"
            android:textColor="@color/slate_900"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/smsTemplateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:lines="4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/settings_mobile_detection_label"
            android:textColor="@color/slate_900"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@color/indigo_50"
            android:padding="12dp"
            android:text="@string/settings_mobile_detection_notice"
            android:textColor="@color/indigo_700"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/countryCheckboxFR"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/country_fr"
                    android:textColor="@color/slate_900"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/countryCheckboxBE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/country_be"
                    android:textColor="@color/slate_900"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/countryCheckboxCH"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/country_ch"
                    android:textColor="@color/slate_900"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/countryCheckboxLU"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/country_lu"
                    android:textColor="@color/slate_900"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/countryCheckboxCA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/country_ca"
                    android:textColor="@color/slate_900"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/countryCheckboxMA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/country_ma"
                    android:textColor="@color/slate_900"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/countryCheckboxDZ"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/country_dz"
                    android:textColor="@color/slate_900"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/countryCheckboxTN"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/country_tn"
                    android:textColor="@color/slate_900"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/settings_dnd_label"
            android:textColor="@color/slate_900"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@color/indigo_50"
            android:padding="12dp"
            android:text="@string/settings_dnd_notice"
            android:textColor="@color/indigo_700"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openDndSettingsButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/settings_dnd_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveSettingsButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/indigo_600"
            android:text="@string/settings_save_button" />

    </LinearLayout>
</ScrollView>
